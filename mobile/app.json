{
  "expo": {
    "name": "온앤온+",
    "slug": "gyeonggi-on",
    "scheme": "onandon",
    "version": "1.0.12",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E6FEA"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kr.gyeonggion.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "주변 축제와 제휴업소를 보여주기 위해 현재 위치가 필요합니다."
      },
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_API_KEY"
      }
    },
    "android": {
      "package": "kr.gyeonggion.app",
      "versionCode": 13,
      "compileSdkVersion": 36,
      "targetSdkVersion": 36,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["INTERNET", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E6FEA"
      },
      "icon": "./assets/icon.png",
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "plugins": [
      "./plugins/withAndroidSdk36",
      "./plugins/withAndroidReleaseSigning",
      "./plugins/withAndroidLauncherIcon",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "주변 축제와 제휴업소를 보여주기 위해 현재 위치가 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "축제 현장 피드를 올리기 위해 사진 접근이 필요합니다.",
          "cameraPermission": "축제 현장 사진을 촬영하기 위해 카메라 접근이 필요합니다."
        }
      ]
    ],
    "androidNavigationBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "온앤온+",
      "shortName": "on&on+"
    }
  }
}
