# Vercel Production(kdanji.com) 빌드에 필요한 공개 환경변수
# 시크릿이 아닌 값만 EXPO_PUBLIC_* 로 넣습니다. expo export 시 번들에 인라인됩니다.

EXPO_PUBLIC_API_URL=https://www.kdanji.com
EXPO_PUBLIC_API_BASE_URL=https://www.kdanji.com
EXPO_PUBLIC_WEB_ORIGIN=https://www.kdanji.com

# 소셜 로그인 (없으면 미리보기 데모 로그인)
# Kakao REST API 키 = OAuth client_id. 콘솔 Redirect URI: https://www.kdanji.com/auth
EXPO_PUBLIC_KAKAO_CLIENT_ID=04a0c5af1674ef99651907be51141277
# Google Cloud 웹 클라이언트 (client_secret 은 EXPO_PUBLIC 에 넣지 말 것)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=770194502672-b7ifu2bqbhs6mp8r0rstmkgnldnioq63.apps.googleusercontent.com
# Android 네이티브 클라이언트(웹 /auth 코드 흐름에는 쓰지 않음)
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=770194502672-qvv3el80kovg6drqpjf0m1he8i270ljq.apps.googleusercontent.com
