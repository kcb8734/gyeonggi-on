# Vercel Production(kdanji.com) 빌드에 필요한 공개 환경변수
# 시크릿이 아닌 값만 EXPO_PUBLIC_* 로 넣습니다. expo export 시 번들에 인라인됩니다.

EXPO_PUBLIC_API_URL=https://api.gyeonggi-on.kr
EXPO_PUBLIC_API_BASE_URL=https://api.gyeonggi-on.kr
EXPO_PUBLIC_WEB_ORIGIN=https://kdanji.com

# 소셜 로그인 (없으면 미리보기 데모 로그인)
EXPO_PUBLIC_KAKAO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
