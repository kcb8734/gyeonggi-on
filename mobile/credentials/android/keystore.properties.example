# Copy to keystore.properties (gitignore) or set env vars.
# Do not commit upload-keystore.jks, *.pem, or this filled-in file.
#
#   ANDROID_KEYSTORE_FILE
#   ANDROID_KEYSTORE_PASSWORD
#   ANDROID_KEY_ALIAS
#   ANDROID_KEY_PASSWORD
#   ANDROID_KEYSTORE_BASE64   (CI: node scripts/play-keystore.cjs restore)
#
# Local Play upload key (SHA1 E4:CA:DA:50:1D:6C:94:5B:9D:11:FA:9A:B5:79:DF:26:22:AB:11:9F)
# valid on Play after 2026-09-06 16:52 UTC.
storeFile=upload-keystore.jks
storePassword=change-me
keyAlias=upload
keyPassword=change-me
