{
  "version": 2,
  "framework": null,
  "installCommand": "npm ci --prefix backend && npm ci --prefix mobile",
  "buildCommand": "npm run build --prefix backend && npm run export:web --prefix mobile",
  "outputDirectory": "mobile/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/festivals",
      "schedule": "0 3 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "kdanji.com" }],
      "destination": "https://www.kdanji.com/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/api/merchants/verify", "destination": "/api" },
    { "source": "/api/health", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/privacy/", "destination": "/privacy/index.html" },
    { "source": "/downloads", "destination": "/downloads/index.html" },
    { "source": "/downloads/", "destination": "/downloads/index.html" },
    { "source": "/((?!_expo/|assets/|privacy|downloads).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/downloads/(.*).aab",
      "headers": [
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/downloads/upload_certificate.pem",
      "headers": [
        { "key": "Content-Type", "value": "application/x-pem-file" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"upload_certificate.pem\"" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ],
  "env": {
    "EXPO_PUBLIC_API_URL": "https://www.kdanji.com",
    "EXPO_PUBLIC_API_BASE_URL": "https://www.kdanji.com",
    "EXPO_PUBLIC_WEB_ORIGIN": "https://www.kdanji.com",
    "NTS_SERVICE_KEY": "ef117e7bebbcea7586234f85acd8292dba6a6d95230131aec62a10b5b2610885"
  }
}
