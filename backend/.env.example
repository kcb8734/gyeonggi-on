# Neon PostgreSQL (sslmode=require)
# git pull은 .env를 갱신하지 않습니다. 로컬 backend/.env에 실제 Neon URL을 넣으세요.
# Neon 콘솔에서 Endpoint가 Active인지, 비밀번호가 맞는지 확인한 뒤 연결 문자열을 복사합니다.
# DATABASE_URL 또는 POSTGRES_URL 중 하나를 설정합니다.
# 예: postgresql://USER:PASSWORD@ep-xxxx.ap-northeast-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# POSTGRES_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# JWT 인증 시크릿 (실제 운영 시 강력한 랜덤 값으로 교체)
JWT_SECRET=change-me-in-production

# 서버 포트
PORT=4000

# 공공데이터포털 국세청 사업자등록 상태조회 serviceKey
# https://api.odcloud.kr/api/nts-businessman/v1/status
# Vercel 대시보드 Environment Variables에도 동일 키(NTS_SERVICE_KEY)를 넣어야
# kdanji.com /api/merchants/verify 가 동작합니다. vercel.json에는 시크릿을 넣지 않습니다.
NTS_SERVICE_KEY=ef117e7bebbcea7586234f85acd8292dba6a6d95230131aec62a10b5b2610885

# 한국관광공사 TourAPI 4.0 (KorService2). KorService1/searchFestival1 은 폐기되어 HTTP 400 입니다.
# https://apis.data.go.kr/B551011/KorService2
TOUR_API_SERVICE_KEY=ef117e7bebbcea7586234f85acd8292dba6a6d95230131aec62a10b5b2610885
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
# 12시간(기본) ~ 24시간. 밀리초.
TOUR_API_CACHE_TTL_MS=43200000

# 관리자 대시보드 로그인
ADMIN_EMAIL=kcb8734@gmail.com
ADMIN_PASSWORD=kimcb8113!

# 지자체 담당자 메일 인증 (Resend)
# Vercel Production에도 RESEND_API_KEY 를 넣어야 kdanji.com에서 실제 메일이 나갑니다.
# 도메인 미인증이면 기본 발신 beth.t@example.com 은 Resend 계정 메일로만 도착합니다.
RESEND_API_KEY=
RESEND_FROM=온앤온+ <beth.t@example.com>

# 경기도 문화행사(GGCULTUREVENTSTUS) OpenAPI
# https://openapi.gg.go.kr/GGCULTUREVENTSTUS
# 백오피스 「즉시 동기화」가 이 키로 XML을 수집합니다. 실제 키는 Vercel/서버 env에만 넣으세요.
GG_CULTURE_API_KEY=

# 인천문화재단 문화예술행사 OpenAPI
# http://ifac.or.kr/openAPI/real/search.do?apiKey=...&svid=culture&resultType=xml
# 백오피스 「즉시 동기화」와 공공수집 탭 인천 행이 이 키로 XML을 수집합니다.
INCHEON_API_KEY=

# 서울시 문화행사(culturalEventInfo) OpenAPI
# http://openapi.seoul.go.kr:8088/{KEY}/xml/culturalEventInfo/{시작}/{종료}/
SEOUL_CULTURE_API_KEY=61794c4e756b63623132304c79785a44

# 나머지 14개 광역 지자체 문화행사 OpenAPI (선택)
# 관리자 「공공수집」 탭에서 권역별로 수집합니다. 인천은 INCHEON_API_KEY(인천문화재단)를 씁니다.
# URL에 {KEY} 가 있으면 키로 치환하고, 없으면 serviceKey 쿼리로 붙입니다.
