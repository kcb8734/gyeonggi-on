# Supabase PostgreSQL Connection Pooler (Transaction 모드) 사용 권장
# 예: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gyeonggi_on

# JWT 인증 시크릿 (실제 운영 시 강력한 랜덤 값으로 교체)
JWT_SECRET=change-me-in-production

# 서버 포트
PORT=4000
