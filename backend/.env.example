# Neon PostgreSQL (sslmode=require)
# DATABASE_URL 또는 POSTGRES_URL 중 하나를 설정합니다.
# 예: postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# POSTGRES_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# JWT 인증 시크릿 (실제 운영 시 강력한 랜덤 값으로 교체)
JWT_SECRET=change-me-in-production

# 서버 포트
PORT=4000

# 공공데이터포털 국세청 사업자등록 상태조회 serviceKey
# https://api.odcloud.kr/api/nts-businessman/v1/status
# Vercel 대시보드 Environment Variables에도 동일 키(NTS_SERVICE_KEY)를 넣어야
# kdanji.com /api/merchants/verify 가 동작합니다. vercel.json에는 시크릿을 넣지 않습니다.
NTS_SERVICE_KEY=ef117e7bebbcea7586234f85acd8292dba6a6d95230131aec62a10b5b2610885

# 한국관광공사 TourAPI 4.0 (KorService2)
# https://apis.data.go.kr/B551011/KorService2
TOUR_API_SERVICE_KEY=ef117e7bebbcea7586234f85acd8292dba6a6d95230131aec62a10b5b2610885
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
# 12시간(기본) ~ 24시간. 밀리초.
TOUR_API_CACHE_TTL_MS=43200000

# 관리자 대시보드 로그인
ADMIN_EMAIL=admin@gyeonggi-on.kr
ADMIN_PASSWORD=admin1234

# 지자체 담당자 메일 인증 (Resend)
RESEND_API_KEY=
RESEND_FROM=온앤온 <noreply@kdanji.com>

# Vercel Cron / 내부 동기화 보호 (선택)
CRON_SECRET=
